{
  "name": "shrink-me",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "pnpm run --parallel \"/^dev:(app|counter)$/\"",
    "dev:app": "vite",
    "dev:counter": "wrangler dev -c workers/counter/wrangler.jsonc",
    "deploy:counter": "wrangler deploy -c workers/counter/wrangler.jsonc",
    "types:counter": "wrangler types -c workers/counter/wrangler.jsonc workers/counter/worker-configuration.d.ts",
    "build": "pnpm run \"/^(type-check|build-only)$/\"",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "format": "oxfmt src/ public/ index.html workers/counter/src/",
    "format:check": "oxfmt --check src/ public/ index.html workers/counter/src/"
  },
  "dependencies": {
    "@okathira/ghostpdl-wasm": "^1.1.0",
    "@vueuse/core": "^15.0.0",
    "animejs": "^4.5.0",
    "compressorjs": "^1.3.0",
    "filesize": "^11.0.25",
    "jszip": "^3.10.2",
    "pinia": "^4.0.3",
    "svgo": "^4.1.0",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.1.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.143.0"
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45"
}
